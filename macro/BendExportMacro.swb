' Generic CadLink schema v0.3 launcher
' Run: Tools > Macro > Run > BendExportMacro.swb
' The v0.3 implementation is kept in the sibling BendExportMacro.dll so that
' SWB and direct DLL execution always use exactly the same geometry rules.

Option Explicit

Private Const SW_RUN_MACRO_DEFAULT As Long = 0
Private Const V03_DLL_NAME As String = "BendExportMacro.dll"

Dim swApp As Object

Sub main()
    If Not ConnectSwApp() Then Exit Sub

    Dim macroFolder As String
    macroFolder = GetThisMacroFolder()
    If Len(macroFolder) = 0 Then
        MsgBox "V03_LAUNCH_FAILED: Could not resolve the SWB folder.", _
            vbCritical, "Generic CadLink schema v0.3"
        Exit Sub
    End If

    Dim dllPath As String
    dllPath = macroFolder & V03_DLL_NAME
    If Dir(dllPath) = "" Then
        MsgBox "V03_DLL_MISSING: The schema v0.3 DLL was not found." & vbCrLf & vbCrLf & _
            dllPath & vbCrLf & vbCrLf & _
            "Run scripts\build-macro.ps1 and keep the DLL beside this SWB file.", _
            vbCritical, "Generic CadLink schema v0.3"
        Exit Sub
    End If

    Dim runError As Long
    Dim succeeded As Boolean
    On Error Resume Next
    succeeded = swApp.RunMacro2(dllPath, "", "Main", SW_RUN_MACRO_DEFAULT, runError)
    Dim callError As Long
    Dim callDescription As String
    callError = Err.Number
    callDescription = Err.Description
    Err.Clear
    On Error GoTo 0

    If Not succeeded Then
        Dim message As String
        message = "V03_DLL_RUN_FAILED: SolidWorks could not run BendExportMacro.dll." & vbCrLf & _
            "RunMacro2 error: " & CStr(runError)
        If callError <> 0 Then
            message = message & vbCrLf & "VBA error: " & CStr(callError) & " - " & callDescription
        End If
        MsgBox message, vbCritical, "Generic CadLink schema v0.3"
    End If
End Sub

Private Function ConnectSwApp() As Boolean
    On Error Resume Next
    Set swApp = Nothing
    Set swApp = GetObject(, "SldWorks.Application")
    If swApp Is Nothing Then Set swApp = Application.SldWorks
    On Error GoTo 0

    If swApp Is Nothing Then
        MsgBox "Could not connect to SolidWorks.", vbCritical, "Generic CadLink schema v0.3"
        ConnectSwApp = False
    Else
        ConnectSwApp = True
    End If
End Function

Private Function GetThisMacroFolder() As String
    Dim folder As String
    folder = ""

    On Error Resume Next
    folder = CStr(swApp.GetCurrentMacroPathFolder)
    Err.Clear

    If Len(Trim(folder)) = 0 Then
        Dim macroPath As String
        macroPath = CStr(swApp.GetCurrentMacroPathName)
        If Len(macroPath) > 0 And InStrRev(macroPath, "\") > 0 Then
            folder = Left(macroPath, InStrRev(macroPath, "\"))
        End If
    End If
    On Error GoTo 0

    If Len(folder) > 0 And Right(folder, 1) <> "\" Then folder = folder & "\"
    GetThisMacroFolder = folder
End Function
