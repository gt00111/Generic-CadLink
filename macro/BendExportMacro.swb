' Generic CadLink - bend.json + flat.dxf export (Phase 1-2)
' Late binding: no VBA References required (.swb can run directly)
' Run: Tools > Macro > Run > BendExportMacro.swb
' Requires GenericCadLink.slddxfmap (or .dxfmap) in the same folder as this macro (layer mapping)

Private Const SW_DOC_PART As Long = 1
Private Const SW_BEND_DIR_UP As Long = 1
Private Const SW_BEND_DIR_DOWN As Long = 2
Private Const SW_SKETCH_LINE As Long = 0
Private Const SW_BEND_LINE_UP As Long = 1
Private Const SW_BEND_LINE_DOWN As Long = 2
Private Const SW_SUPPRESS_FEATURE As Long = 0
Private Const SW_UNSUPPRESS_FEATURE As Long = 1
Private Const SW_THIS_CONFIGURATION As Long = 2
Private Const SW_EXPORT_SHEET_METAL As Long = 1
Private Const SW_SM_OPT_GEOMETRY As Long = 1
Private Const SW_SM_OPT_BEND_LINES As Long = 4
Private Const SW_FP_OPT_GEOMETRY As Long = 1
Private Const SW_FP_OPT_BEND_LINES As Long = 2
Private Const CADLINK_VERSION As String = "0.2.1"
Private Const DXF_MAP_FILE As String = "GenericCadLink.slddxfmap"
Private Const DXF_MAP_FILE_ALT As String = "GenericCadLink.dxfmap"
Private Const CONFIG_FILE As String = "cadlink.config.json"
Private Const DEFAULT_EXPORT_FOLDER As String = "CadLinkExport"

Dim swApp As Object
Dim gFlatBendDirs As Object
Dim gFlatBendLengths As Object
Dim gCurrentBendIndex As Long
Dim gLastDirWarning As String
Dim gFlatPatternWasSuppressed As Boolean
Dim gBendLengthUnknownCount As Long

Sub main()
    If Not ConnectSwApp() Then Exit Sub
    ExportBendJson
End Sub

Private Function ConnectSwApp() As Boolean
    On Error Resume Next
    Set swApp = Nothing
    Set swApp = GetObject(, "SldWorks.Application")
    If swApp Is Nothing Then
        Set swApp = Application.SldWorks
    End If
    On Error GoTo 0
    If swApp Is Nothing Then
        MsgBox "Could not connect to SolidWorks.", vbCritical, "Generic CadLink"
        ConnectSwApp = False
    Else
        ConnectSwApp = True
    End If
End Function

Private Sub ExportBendJson()
    If swApp Is Nothing Then
        If Not ConnectSwApp() Then Exit Sub
    End If

    Dim swModel As Object
    Set swModel = swApp.ActiveDoc

    Dim errors As String
    Dim warnings As String
    errors = ""
    warnings = ""

    If swModel Is Nothing Then
        errors = errors & "NO_ACTIVE_DOCUMENT: No open document." & vbCrLf
        ShowResult "", "", "", 0, "", errors, warnings
        Exit Sub
    End If

    If swModel.GetType <> SW_DOC_PART Then
        errors = errors & "NOT_PART: Open a sheet metal part (.sldprt)." & vbCrLf
        ShowResult "", "", "", 0, "", errors, warnings
        GoTo Cleanup
    End If

    Dim partPath As String
    partPath = swModel.GetPathName
    If Len(Trim(partPath)) = 0 Then
        errors = errors & "UNSAVED_DOCUMENT: Save the file before running." & vbCrLf
        ShowResult "", "", "", 0, "", errors, warnings
        GoTo Cleanup
    End If

    Dim swPart As Object
    Set swPart = swModel

    If Not HasFlatPattern(swModel, errors, warnings) Then
        ShowResult partPath, "", "", 0, "", errors, warnings
        GoTo Cleanup
    End If

    Dim thickness As Double
    If Not GetThickness(swModel, swPart, thickness) Then
        errors = errors & "THICKNESS_UNKNOWN: Could not read sheet thickness." & vbCrLf
        ShowResult partPath, "", "", 0, "", errors, warnings
        GoTo Cleanup
    End If

    Dim materialName As String
    materialName = GetMaterialName(swPart, warnings)

    Dim bendsJson As String
    Dim bendCount As Long
    bendsJson = CollectBendsJson(swModel, warnings, bendCount)

    If bendCount = 0 And Len(errors) = 0 Then
        warnings = warnings & "NO_BENDS: No bend features found." & vbCrLf
    End If

    Dim partNumber As String
    partNumber = GetPartNumber(partPath)

    Dim outputDir As String
    outputDir = ResolvePartOutputDir(partPath, partNumber, warnings)
    If Len(outputDir) = 0 Then
        errors = errors & "OUTPUT_DIR_FAILED: Could not create export folder." & vbCrLf
        ShowResult partPath, "", "", 0, "", errors, warnings
        GoTo Cleanup
    End If

    Dim outPath As String
    outPath = outputDir & "bend.json"

    Dim dxfPath As String
    Dim dxfWarn As String
    dxfPath = outputDir & "flat.dxf"
    If Not ExportFlatDxf(swModel, swPart, partPath, dxfPath, bendCount, dxfWarn) Then
        errors = errors & "DXF_EXPORT_FAILED: Could not export flat.dxf." & vbCrLf
    End If
    If Len(dxfWarn) > 0 Then warnings = warnings & dxfWarn

    bendsJson = PatchBendLengthsFromDxf(bendsJson, dxfPath)

    If gBendLengthUnknownCount > 0 Then
        warnings = warnings & "BEND_LENGTH_UNKNOWN: " & gBendLengthUnknownCount & " bend(s) - length not available from SW API." & vbCrLf
    End If

    Dim json As String
    json = BuildJson(partPath, partNumber, thickness, materialName, bendsJson, errors, warnings)
    WriteUtf8 outPath, json

    ShowResult partPath, outPath, dxfPath, bendCount, CStr(thickness), errors, warnings

Cleanup:
    RestoreRollbackBar swModel
End Sub

Private Function GetCadLinkMacroFolder() As String
    On Error Resume Next
    Dim folder As String
    folder = swApp.GetCurrentMacroPathFolder
    If Len(folder) > 0 Then
        If Right(folder, 1) <> "\" Then folder = folder & "\"
        GetCadLinkMacroFolder = folder
    End If
    Err.Clear
End Function

Private Function GetDxfMapPath() As String
    Dim folder As String
    folder = GetCadLinkMacroFolder()
    If Len(folder) = 0 Then Exit Function
    If Dir(folder & DXF_MAP_FILE) <> "" Then
        GetDxfMapPath = folder & DXF_MAP_FILE
    ElseIf Dir(folder & DXF_MAP_FILE_ALT) <> "" Then
        GetDxfMapPath = folder & DXF_MAP_FILE_ALT
    End If
End Function

Private Function TryExportFlatPatternView(swPart As Object, dxfPath As String, options As Long, mapPath As String, ByRef errDesc As String) As Boolean
    errDesc = ""
    On Error Resume Next

    TryExportFlatPatternView = swPart.ExportFlatPatternView(dxfPath, options, mapPath, True, False, 0, 0)
    If Err.Number <> 0 Then
        errDesc = Err.Description
        Err.Clear
        TryExportFlatPatternView = False
    End If
    If TryExportFlatPatternView Then Exit Function

    If Len(mapPath) > 0 Then
        TryExportFlatPatternView = swPart.ExportFlatPatternView(dxfPath, options, "", True, False, 0, 0)
        If Err.Number <> 0 Then
            errDesc = Err.Description
            Err.Clear
            TryExportFlatPatternView = False
        End If
        If TryExportFlatPatternView Then Exit Function
    End If

    TryExportFlatPatternView = swPart.ExportFlatPatternView(dxfPath, options)
    If Err.Number <> 0 Then
        errDesc = Err.Description
        Err.Clear
        TryExportFlatPatternView = False
    End If
End Function

Private Function ExportFlatDxf(swModel As Object, swPart As Object, partPath As String, dxfPath As String, expectedBendCount As Long, ByRef dxfWarn As String) As Boolean
    dxfWarn = ""
    ExportFlatDxf = False

    Dim wasSuppressed As Boolean
    wasSuppressed = PrepareFlatPatternForRead(swModel)

    Dim mapPath As String
    mapPath = GetDxfMapPath()
    If Len(mapPath) = 0 Then
        dxfWarn = dxfWarn & "DXF_MAP_MISSING: GenericCadLink.slddxfmap not found beside macro." & vbCrLf
    End If

    ActivateDxfMapFile mapPath

    Dim ok As Boolean
    ok = ExportFlatDxfViaExportToDWG2(swPart, partPath, dxfPath, mapPath)

    If Not ok Then
        Dim exportErr As String
        Dim options As Long
        options = SW_FP_OPT_GEOMETRY Or SW_FP_OPT_BEND_LINES
        ok = TryExportFlatPatternView(swPart, dxfPath, options, mapPath, exportErr)
        If Not ok And Len(exportErr) > 0 Then
            dxfWarn = dxfWarn & "DXF_EXPORT_NOTE: ExportFlatPatternView failed (" & exportErr & ")." & vbCrLf
        End If
    End If

    RestoreFlatPatternSuppression swModel, wasSuppressed

    If Not ok Then Exit Function
    If Dir(dxfPath) = "" Then
        dxfWarn = dxfWarn & "DXF_EXPORT_FAILED: API returned success but file was not created." & vbCrLf
        Exit Function
    End If

    Dim bendLineCount As Long
    If Not RemapCadLinkDxfLayers(dxfPath, gFlatBendDirs, bendLineCount, dxfWarn) Then
        dxfWarn = dxfWarn & "DXF_LAYER_REMAP_FAILED: Could not assign CUT/BEND layers." & vbCrLf
    ElseIf expectedBendCount > 0 Then
        If bendLineCount <> expectedBendCount Then
            dxfWarn = dxfWarn & "DXF_BEND_LINE_MISMATCH: DXF bend lines=" & bendLineCount & ", bends[]=" & expectedBendCount & vbCrLf
        End If
    End If

    ExportFlatDxf = True
End Function

Private Sub ActivateDxfMapFile(mapPath As String)
    On Error Resume Next
    Const SW_PREF_DXF_MAPPING As Long = 12
    Const SW_PREF_DXF_NO_MAP_DIALOG As Long = 13
    Const SW_PREF_DXF_MAP_INDEX As Long = 44
    Const SW_PREF_DXF_MAP_FILES As Long = 23

    swApp.SetUserPreferenceToggle SW_PREF_DXF_MAPPING, True
    swApp.SetUserPreferenceToggle SW_PREF_DXF_NO_MAP_DIALOG, True

    If Len(mapPath) = 0 Then Exit Sub

    Dim idx As Long
    idx = FindOrRegisterDxfMapFile(mapPath, SW_PREF_DXF_MAP_FILES)
    If idx >= 0 Then swApp.SetUserPreferenceIntegerValue SW_PREF_DXF_MAP_INDEX, idx
    Err.Clear
End Sub

Private Function FindOrRegisterDxfMapFile(mapPath As String, prefListId As Long) As Long
    On Error Resume Next
    FindOrRegisterDxfMapFile = -1

    Dim vMaps As Variant
    Dim i As Long
    vMaps = swApp.GetUserPreferenceStringListValue(prefListId)
    If Not IsEmpty(vMaps) Then
        For i = LBound(vMaps) To UBound(vMaps)
            If StrComp(CStr(vMaps(i)), mapPath, vbTextCompare) = 0 Then
                FindOrRegisterDxfMapFile = i
                Exit Function
            End If
        Next i
    End If

    swApp.SetUserPreferenceStringListValue prefListId, mapPath
    vMaps = swApp.GetUserPreferenceStringListValue(prefListId)
    If IsEmpty(vMaps) Then Exit Function
    For i = LBound(vMaps) To UBound(vMaps)
        If StrComp(CStr(vMaps(i)), mapPath, vbTextCompare) = 0 Then
            FindOrRegisterDxfMapFile = i
            Exit Function
        End If
    Next i
End Function

Private Function ExportFlatDxfViaExportToDWG2(swPart As Object, partPath As String, dxfPath As String, mapPath As String) As Boolean
    On Error Resume Next
    Dim smOptions As Long
    smOptions = SW_SM_OPT_GEOMETRY Or SW_SM_OPT_BEND_LINES
    ExportFlatDxfViaExportToDWG2 = swPart.ExportToDWG2(dxfPath, partPath, SW_EXPORT_SHEET_METAL, True, Empty, False, False, smOptions, Empty)
    Err.Clear
End Function

Private Function RemapCadLinkDxfLayers(dxfPath As String, bendDirs As Object, ByRef bendLineCount As Long, ByRef remapWarn As String) As Boolean
    bendLineCount = 0
    RemapCadLinkDxfLayers = False

    Dim content As String
    content = ReadWholeFile(dxfPath)
    If Len(content) = 0 Then Exit Function

    content = InsertCadLinkLayersInContent(content)

    Dim lines() As String
    lines = SplitLinesAny(content)
    RemapCadLinkEntityLayers lines, bendDirs, bendLineCount

    WriteWholeFile dxfPath, JoinLines(lines)
    RemapCadLinkDxfLayers = True
End Function

Private Function InsertCadLinkLayersInContent(content As String) As String
    InsertCadLinkLayersInContent = content
    If InStr(1, content, vbCrLf & "  2" & vbCrLf & "CUT" & vbCrLf, vbBinaryCompare) > 0 Then Exit Function

    Dim layerPos As Long
    layerPos = InStr(1, content, vbCrLf & "  2" & vbCrLf & "LAYER" & vbCrLf, vbBinaryCompare)
    If layerPos = 0 Then Exit Function

    Dim endTabPos As Long
    endTabPos = InStr(layerPos, content, vbCrLf & "  0" & vbCrLf & "ENDTAB" & vbCrLf, vbBinaryCompare)
    If endTabPos = 0 Then Exit Function

    Dim block As String
    block = vbCrLf & CadLinkLayerBlock("CUT", 7, "Continuous") & vbCrLf & _
        CadLinkLayerBlock("BEND_UP", 3, "DASHED") & vbCrLf & _
        CadLinkLayerBlock("BEND_DOWN", 4, "DASHED")

    InsertCadLinkLayersInContent = Left$(content, endTabPos - 1) & block & Mid$(content, endTabPos)
    InsertCadLinkLayersInContent = IncrementLayerTableCountInContent(InsertCadLinkLayersInContent, 3)
End Function

Private Function IncrementLayerTableCountInContent(content As String, addCount As Long) As String
    IncrementLayerTableCountInContent = content
    Dim layerPos As Long
    layerPos = InStr(1, content, vbCrLf & "  2" & vbCrLf & "LAYER" & vbCrLf, vbBinaryCompare)
    If layerPos = 0 Then Exit Function

    Dim countPos As Long
    countPos = InStr(layerPos, content, vbCrLf & " 70" & vbCrLf, vbBinaryCompare)
    If countPos = 0 Then Exit Function

    Dim lineStart As Long
    lineStart = countPos + Len(vbCrLf & " 70" & vbCrLf)
    Dim lineEnd As Long
    lineEnd = InStr(lineStart, content, vbCrLf)
    If lineEnd = 0 Then Exit Function

    Dim oldCount As Long
    oldCount = CLng(Trim$(Mid$(content, lineStart, lineEnd - lineStart)))
    IncrementLayerTableCountInContent = Left$(content, lineStart - 1) & CStr(oldCount + addCount) & Mid$(content, lineEnd)
End Function

Private Function CadLinkLayerBlock(layerName As String, color As Long, lineType As String) As String
    CadLinkLayerBlock = "  0" & vbCrLf & "LAYER" & vbCrLf & _
        "  5" & vbCrLf & "CL" & layerName & vbCrLf & _
        "330" & vbCrLf & "2" & vbCrLf & _
        "100" & vbCrLf & "AcDbSymbolTableRecord" & vbCrLf & _
        "100" & vbCrLf & "AcDbLayerTableRecord" & vbCrLf & _
        "  2" & vbCrLf & layerName & vbCrLf & _
        " 70" & vbCrLf & "0" & vbCrLf & _
        " 62" & vbCrLf & CStr(color) & vbCrLf & _
        "  6" & vbCrLf & lineType
End Function

Private Sub RemapCadLinkEntityLayers(lines() As String, bendDirs As Object, ByRef bendLineCount As Long)
    bendLineCount = 0
    Dim inEntities As Boolean
    inEntities = False
    Dim i As Long
    i = 0
    Do While i <= UBound(lines) - 1
        If lines(i) = "  2" And lines(i + 1) = "ENTITIES" Then
            inEntities = True
            i = i + 2
        ElseIf inEntities And lines(i) = "  0" Then
            If lines(i + 1) = "ENDSEC" Then Exit Do
            Dim entType As String
            entType = lines(i + 1)
            Dim targetLayer As String
            targetLayer = ClassifyCadLinkEntityLayer(entType, lines, i, bendDirs, bendLineCount)
            If Len(targetLayer) > 0 Then SetEntityLayerValue lines, i, targetLayer
            i = i + 2
        Else
            i = i + 1
        End If
    Loop
End Sub

Private Function ClassifyCadLinkEntityLayer(entType As String, lines() As String, startIdx As Long, bendDirs As Object, ByRef bendLineCount As Long) As String
    Dim linetype As String
    linetype = ReadEntityGroupValue(lines, startIdx, "  6")

    If entType = "LINE" And IsBendLineLinetype(linetype) Then
        ClassifyCadLinkEntityLayer = BendLayerNameForIndex(bendDirs, bendLineCount)
        bendLineCount = bendLineCount + 1
        Exit Function
    End If

    Select Case entType
        Case "LINE", "ARC", "LWPOLYLINE", "POLYLINE", "CIRCLE", "SPLINE", "ELLIPSE", "POINT"
            ClassifyCadLinkEntityLayer = "CUT"
    End Select
End Function

Private Function ReadEntityGroupValue(lines() As String, startIdx As Long, groupCode As String) As String
    Dim i As Long
    i = startIdx + 2
    Do While i <= UBound(lines) - 1
        If lines(i) = "  0" Then Exit Function
        If lines(i) = groupCode Then
            ReadEntityGroupValue = lines(i + 1)
            Exit Function
        End If
        i = i + 2
    Loop
End Function

Private Function IsBendLineLinetype(linetype As String) As Boolean
    Select Case UCase$(Trim$(linetype))
        Case "CENTER", "DASHED", "PHANTOM", "HIDDEN", "CENTERX2"
            IsBendLineLinetype = True
    End Select
End Function

Private Function BendLayerNameForIndex(bendDirs As Object, bendIdx As Long) As String
    If Not bendDirs Is Nothing Then
        If bendIdx >= 0 And bendIdx < bendDirs.Count Then
            If bendDirs(bendIdx) = "down" Then
                BendLayerNameForIndex = "BEND_DOWN"
                Exit Function
            End If
        End If
    End If
    BendLayerNameForIndex = "BEND_UP"
End Function

Private Sub SetEntityLayerValue(lines() As String, startIdx As Long, layerName As String)
    Dim i As Long
    i = startIdx + 2
    Do While i <= UBound(lines) - 1
        If lines(i) = "  0" Then Exit Sub
        If lines(i) = "  8" Then
            lines(i + 1) = layerName
            Exit Sub
        End If
        i = i + 2
    Loop
End Sub

Private Function PatchBendLengthsFromDxf(bendsJson As String, dxfPath As String) As String
    PatchBendLengthsFromDxf = bendsJson
    If Dir(dxfPath) = "" Then Exit Function

    Dim lengths() As Double
    lengths = ExtractBendLineLengthsFromDxf(dxfPath)
    If UBound(lengths) < LBound(lengths) Then Exit Function

    Dim result As String
    result = bendsJson
    Dim i As Long
    For i = LBound(lengths) To UBound(lengths)
        Dim updated As String
        updated = ReplaceFirstNullLengthMm(result, lengths(i))
        If updated = result Then Exit For
        result = updated
        gBendLengthUnknownCount = gBendLengthUnknownCount - 1
        If gBendLengthUnknownCount < 0 Then gBendLengthUnknownCount = 0
    Next i
    PatchBendLengthsFromDxf = result
End Function

Private Function ReplaceFirstNullLengthMm(json As String, lengthMm As Double) As String
    Dim marker As String
    marker = """lengthMm"": null"
    Dim pos As Long
    pos = InStr(json, marker)
    If pos = 0 Then
        ReplaceFirstNullLengthMm = json
        Exit Function
    End If
    ReplaceFirstNullLengthMm = Left$(json, pos - 1) & """lengthMm"": " & JsonNum(lengthMm) & Mid$(json, pos + Len(marker))
End Function

Private Function ExtractBendLineLengthsFromDxf(dxfPath As String) As Double()
    Dim emptyArr(-1 To -1) As Double
    ExtractBendLineLengthsFromDxf = emptyArr

    Dim content As String
    content = ReadWholeFile(dxfPath)
    If Len(content) = 0 Then Exit Function

    Dim lines() As String
    lines = SplitLinesAny(content)

    Dim lengths() As Double
    ReDim lengths(0)
    Dim count As Long
    count = 0

    Dim inEntities As Boolean
    inEntities = False
    Dim i As Long
    i = 0
    Do While i <= UBound(lines) - 1
        If lines(i) = "  2" And lines(i + 1) = "ENTITIES" Then
            inEntities = True
            i = i + 2
        ElseIf inEntities And lines(i) = "  0" Then
            If lines(i + 1) = "ENDSEC" Then Exit Do
            If lines(i + 1) = "LINE" Then
                Dim lt As String
                lt = ReadEntityGroupValue(lines, i, "  6")
                Dim layerName As String
                layerName = ReadEntityGroupValue(lines, i, "  8")
                If IsBendLineLinetype(lt) Or layerName = "BEND_UP" Or layerName = "BEND_DOWN" Then
                    Dim segLen As Double
                    segLen = ReadLineEntityLengthMm(lines, i)
                    If segLen > 0 Then
                        ReDim Preserve lengths(count)
                        lengths(count) = Round4(segLen)
                        count = count + 1
                    End If
                End If
            End If
            i = i + 2
        Else
            i = i + 1
        End If
    Loop

    If count = 0 Then
        ExtractBendLineLengthsFromDxf = emptyArr
    Else
        ReDim Preserve lengths(count - 1)
        ExtractBendLineLengthsFromDxf = lengths
    End If
End Function

Private Function ReadLineEntityLengthMm(lines() As String, startIdx As Long) As Double
    On Error GoTo Fail
    Dim x1 As Double, y1 As Double, x2 As Double, y2 As Double
    Dim got1 As Boolean, got2 As Boolean
    got1 = False
    got2 = False
    Dim i As Long
    i = startIdx + 2
    Do While i <= UBound(lines) - 1
        If lines(i) = "  0" Then Exit Do
        If lines(i) = " 10" Then x1 = CDbl(lines(i + 1)): got1 = True
        If lines(i) = " 20" Then y1 = CDbl(lines(i + 1)): got1 = True
        If lines(i) = " 11" Then x2 = CDbl(lines(i + 1)): got2 = True
        If lines(i) = " 21" Then y2 = CDbl(lines(i + 1)): got2 = True
        i = i + 2
    Loop
    If got1 And got2 Then
        ReadLineEntityLengthMm = Sqr((x2 - x1) ^ 2 + (y2 - y1) ^ 2)
    End If
    Exit Function
Fail:
    ReadLineEntityLengthMm = 0
End Function

Private Function ReadWholeFile(path As String) As String
    On Error GoTo Fail
    Dim fn As Integer
    fn = FreeFile
    Open path For Binary As #fn
    ReadWholeFile = Input$(LOF(fn), fn)
    Close #fn
    Exit Function
Fail:
    ReadWholeFile = ""
End Function

Private Sub WriteWholeFile(path As String, content As String)
    On Error Resume Next
    Dim fn As Integer
    fn = FreeFile
    Open path For Binary As #fn
    Put #fn, , content
    Close #fn
End Sub

Private Function SplitLinesAny(content As String) As String()
    Dim normalized As String
    normalized = Replace(content, vbCrLf, vbLf)
    normalized = Replace(normalized, vbCr, vbLf)
    SplitLinesAny = Split(normalized, vbLf)
End Function

Private Function JoinLines(lines() As String) As String
    JoinLines = Join(lines, vbCrLf)
End Function

Private Sub RestoreRollbackBar(swModel As Object)
    ' AccessSelections leaves rollback bar — move it back to end
    On Error Resume Next
    If swModel Is Nothing Then Exit Sub
    swModel.FeatureManager.EditRollback2 Nothing, 2
    swModel.EditRebuild3
    swModel.ClearSelection2 True
End Sub

Private Function HasFlatPattern(swModel As Object, ByRef errors As String, ByRef warnings As String) As Boolean
    Dim swFeat As Object
    Set swFeat = FindFeatureByType(swModel, "FlatPattern")
    If swFeat Is Nothing Then
        errors = errors & "NO_FLAT_PATTERN: Flat pattern feature not found." & vbCrLf
        HasFlatPattern = False
        Exit Function
    End If
    HasFlatPattern = True
End Function

Private Function GetThickness(swModel As Object, swPart As Object, ByRef thickness As Double) As Boolean
    Dim swFeat As Object
    Set swFeat = FindFeatureByType(swModel, "SheetMetal")
    If Not swFeat Is Nothing Then
        Dim smData As Object
        Dim accessed As Boolean
        accessed = False
        Set smData = swFeat.GetDefinition
        On Error Resume Next
        smData.AccessSelections swModel, Nothing
        accessed = (Err.Number = 0)
        Err.Clear
        On Error GoTo 0
        thickness = ToMm(smData.Thickness)
        If accessed Then
            On Error Resume Next
            smData.ReleaseSelectionAccess
        End If
        If thickness > 0 Then
            GetThickness = True
            Exit Function
        End If
    End If
    On Error Resume Next
    thickness = ToMm(swPart.GetSheetMetalThickness)
    If thickness > 0 Then
        GetThickness = True
    Else
        GetThickness = False
    End If
    On Error GoTo 0
End Function

Private Function GetMaterialName(swPart As Object, ByRef warnings As String) As String
    On Error GoTo Fail
    Dim matName As String
    Dim dbName As String
    dbName = ""
    matName = swPart.GetMaterialPropertyName2("", dbName)
    If Len(Trim(matName)) > 0 Then
        GetMaterialName = Trim(matName)
    Else
        warnings = warnings & "MATERIAL_UNKNOWN: Material name not found." & vbCrLf
        GetMaterialName = ""
    End If
    Exit Function
Fail:
    warnings = warnings & "MATERIAL_UNKNOWN: Material name not found." & vbCrLf
    GetMaterialName = ""
End Function

Private Function CollectBendsJson(swModel As Object, ByRef warnings As String, ByRef bendCount As Long) As String
    Dim result As String
    result = ""
    bendCount = 0

    Set gFlatBendDirs = CreateObject("Scripting.Dictionary")
    Set gFlatBendLengths = CreateObject("Scripting.Dictionary")
    gCurrentBendIndex = 0
    gBendLengthUnknownCount = 0
    gFlatPatternWasSuppressed = PrepareFlatPatternForRead(swModel)
    CollectFlatPatternBendDirections swModel
    RestoreFlatPatternSuppression swModel, gFlatPatternWasSuppressed

    Dim userBends As Object
    Dim oneBends As Object
    Set userBends = CreateObject("Scripting.Dictionary")
    Set oneBends = CreateObject("Scripting.Dictionary")

    Dim swTop As Object
    Set swTop = swModel.FirstFeature
    Do While Not swTop Is Nothing
        CollectBendCandidatesInTree swTop, userBends, oneBends, False
        Set swTop = swTop.GetNextFeature
    Loop

    Dim exportBends As Object
    If oneBends.Count > 0 Then
        Set exportBends = oneBends
    Else
        Set exportBends = userBends
    End If

    Dim i As Long
    For i = 0 To exportBends.Count - 1
        Dim swFeat As Object
        Set swFeat = exportBends(CStr(i))
        bendCount = bendCount + 1
        Dim bendJson As String
        Dim warnLine As String
        bendJson = BendToJson(swModel, swFeat, bendCount, warnLine)
        If Len(bendJson) > 0 Then
            If Len(result) > 0 Then result = result & "," & vbCrLf
            result = result & bendJson
        Else
            bendCount = bendCount - 1
        End If
        If Len(warnLine) > 0 Then warnings = warnings & warnLine & vbCrLf
    Next i

    If gBendLengthUnknownCount > 0 Then
        ' Filled from flat.dxf after export when possible; keep summary only if still unknown.
    End If

    CollectBendsJson = result
End Function

Private Sub CollectBendCandidatesInTree(swFeat As Object, userBends As Object, oneBends As Object, underFlatPattern As Boolean)
    Dim inFlat As Boolean
    inFlat = underFlatPattern
    If swFeat.GetTypeName2 = "FlatPattern" Then inFlat = True

    Dim typeName As String
    typeName = swFeat.GetTypeName2

    If typeName = "OneBend" And Not inFlat Then
        oneBends.Add CStr(oneBends.Count), swFeat
    ElseIf IsUserLevelBendType(typeName) Then
        userBends.Add CStr(userBends.Count), swFeat
    End If

    Dim swSub As Object
    Set swSub = swFeat.GetFirstSubFeature
    Do While Not swSub Is Nothing
        CollectBendCandidatesInTree swSub, userBends, oneBends, inFlat
        Set swSub = swSub.GetNextSubFeature
    Loop
End Sub

Private Function IsUserLevelBendType(typeName As String) As Boolean
    Select Case typeName
        Case "SM3dBend", "EdgeFlange", "SketchBend", "SweepBend", "MiterFlange"
            IsUserLevelBendType = True
        Case Else
            IsUserLevelBendType = False
    End Select
End Function

Private Function IsBendFeatureType(typeName As String) As Boolean
    Select Case typeName
        Case "SM3dBend", "EdgeFlange", "SketchBend", "SweepBend", "MiterFlange", "OneBend"
            IsBendFeatureType = True
        Case Else
            IsBendFeatureType = False
    End Select
End Function

Private Function BendToJson(swModel As Object, swFeat As Object, bendIndex As Long, ByRef warning As String) As String
    warning = ""
    Dim direction As String
    Dim innerR As Double
    Dim angleRad As Double
    Dim errMsg As String
    Dim featName As String
    featName = swFeat.Name
    gCurrentBendIndex = bendIndex
    gLastDirWarning = ""

    direction = ReadBendDirection(swModel, swFeat, innerR, angleRad, errMsg)
    If Len(direction) = 0 Then
        If Len(errMsg) = 0 Then errMsg = "Could not read bend geometry or direction."
        warning = "BEND_PARSE_FAILED: '" & featName & "' - " & errMsg
        BendToJson = ""
        Exit Function
    End If
    If Len(gLastDirWarning) > 0 Then
        warning = gLastDirWarning & ": '" & featName & "'"
    End If

    Dim angleDeg As Double
    angleDeg = Round4(angleRad * 180# / 3.14159265358979)

    Dim lengthMm As Variant
    lengthMm = GetBendLengthMm(swFeat)
    Dim lengthPart As String
    If IsEmpty(lengthMm) Then
        lengthPart = "null"
        gBendLengthUnknownCount = gBendLengthUnknownCount + 1
    Else
        lengthPart = JsonNum(CDbl(lengthMm))
    End If

    Dim dxfLayer As String
    If direction = "up" Then
        dxfLayer = "BEND_UP"
    Else
        dxfLayer = "BEND_DOWN"
    End If

    BendToJson = "    {" & vbCrLf & _
        "      ""id"": ""B" & bendIndex & """," & vbCrLf & _
        "      ""dxfLayer"": """ & dxfLayer & """," & vbCrLf & _
        "      ""direction"": """ & direction & """," & vbCrLf & _
        "      ""innerRadius"": " & JsonNum(Round4(innerR)) & "," & vbCrLf & _
        "      ""angleDeg"": " & JsonNum(angleDeg) & "," & vbCrLf & _
        "      ""lengthMm"": " & lengthPart & "," & vbCrLf & _
        "      ""swFeatureName"": """ & JsonEscape(featName) & """" & vbCrLf & _
        "    }"
End Function

Private Function ReadBendDirection(swModel As Object, swFeat As Object, ByRef innerR As Double, ByRef angleRad As Double, ByRef errMsg As String) As String
    errMsg = ""
    ReadBendDirection = ""

    Dim typeName As String
    typeName = swFeat.GetTypeName2
    If Not IsBendFeatureType(typeName) Then
        errMsg = "Unsupported bend feature type: " & typeName
        Exit Function
    End If

    Dim bendDef As Object
    Set bendDef = swFeat.GetDefinition
    If bendDef Is Nothing Then
        errMsg = "GetDefinition returned Nothing."
        Exit Function
    End If

    Dim accessed As Boolean
    accessed = False
    On Error Resume Next
    bendDef.AccessSelections swModel, Nothing
    accessed = (Err.Number = 0)
    Err.Clear

    innerR = ToMm(CDbl(bendDef.BendRadius))
    If Err.Number <> 0 Then
        errMsg = "BendRadius: " & Err.Description
        Err.Clear
        GoTo ReleaseAndExit
    End If

    If typeName = "EdgeFlange" Or typeName = "MiterFlange" Then
        ' Edge/Miter flange: BendAngle works; direction uses ReverseDirection (not BendDirection)
        If Not ReadEdgeFlangeAngle(bendDef, angleRad, errMsg) Then GoTo ReleaseAndExit
        ReadBendDirection = MapEdgeFlangeDirection(swFeat, bendDef, errMsg)
    ElseIf typeName = "OneBend" Then
        angleRad = CDbl(bendDef.BendAngle)
        If Err.Number <> 0 Then
            errMsg = "BendAngle: " & Err.Description
            Err.Clear
            GoTo ReleaseAndExit
        End If
        ReadBendDirection = MapOneBendDirection(bendDef, errMsg)
    Else
        angleRad = CDbl(bendDef.BendAngle)
        If Err.Number <> 0 Then
            errMsg = "BendAngle: " & Err.Description
            Err.Clear
            GoTo ReleaseAndExit
        End If
        ReadBendDirection = MapDirection(CLng(bendDef.BendDirection), errMsg)
        If Err.Number <> 0 Then
            errMsg = "BendDirection: " & Err.Description
            Err.Clear
            ReadBendDirection = ""
        End If
    End If

    If Len(ReadBendDirection) = 0 Then
        ReadBendDirection = ResolveBendDirectionFallback()
    End If

ReleaseAndExit:
    If accessed Then
        On Error Resume Next
        bendDef.ReleaseSelectionAccess
    End If
    Exit Function

Fail:
    errMsg = "Failed to read bend: " & Err.Description
    GoTo ReleaseAndExit
End Function

Private Function ReadEdgeFlangeAngle(bendDef As Object, ByRef angleRad As Double, ByRef errMsg As String) As Boolean
    On Error Resume Next
    angleRad = CDbl(bendDef.BendAngle)
    If Err.Number = 0 Then
        errMsg = ""
        ReadEdgeFlangeAngle = True
        Exit Function
    End If
    Err.Clear
    angleRad = CDbl(bendDef.Angle)
    If Err.Number = 0 Then
        errMsg = ""
        ReadEdgeFlangeAngle = True
        Exit Function
    End If
    errMsg = "BendAngle: " & Err.Description
    Err.Clear
    ReadEdgeFlangeAngle = False
End Function

Private Function MapOneBendDirection(bendDef As Object, ByRef errMsg As String) As String
    On Error Resume Next
    Dim bendDown As Boolean
    bendDown = bendDef.BendDown
    If Err.Number <> 0 Then
        Err.Clear
        errMsg = "BendDown not available."
        MapOneBendDirection = ""
        Exit Function
    End If
    errMsg = ""
    If bendDown Then
        MapOneBendDirection = "down"
    Else
        MapOneBendDirection = "up"
    End If
End Function

Private Function MapEdgeFlangeDirection(swFeat As Object, bendDef As Object, ByRef errMsg As String) As String
    On Error Resume Next
    Dim bendDir As Long
    bendDir = CLng(bendDef.BendDirection)
    If Err.Number = 0 Then
        MapEdgeFlangeDirection = MapDirection(bendDir, errMsg)
        If Len(MapEdgeFlangeDirection) > 0 Then Exit Function
    End If
    Err.Clear

    Dim reversed As Boolean
    reversed = bendDef.ReverseDirection
    If Err.Number = 0 Then
        errMsg = ""
        If reversed Then
            MapEdgeFlangeDirection = "down"
        Else
            MapEdgeFlangeDirection = "up"
        End If
        Exit Function
    End If
    Err.Clear

    Dim dirFromSketch As String
    dirFromSketch = GetBendDirectionFromFeatureSketch(swFeat)
    If Len(dirFromSketch) > 0 Then
        errMsg = ""
        MapEdgeFlangeDirection = dirFromSketch
        Exit Function
    End If

    If Not gFlatBendDirs Is Nothing Then
        If gCurrentBendIndex > 0 And gCurrentBendIndex <= gFlatBendDirs.Count Then
            errMsg = ""
            MapEdgeFlangeDirection = gFlatBendDirs(gCurrentBendIndex - 1)
            Exit Function
        End If
    End If

    errMsg = "Bend direction not available on feature or flat-pattern bend lines."
    MapEdgeFlangeDirection = ""
End Function

Private Function ResolveBendDirectionFallback() As String
    ResolveBendDirectionFallback = GetFlatPatternDirectionByIndex(gCurrentBendIndex)
    If Len(ResolveBendDirectionFallback) > 0 Then
        gLastDirWarning = "BEND_DIRECTION_FROM_FLAT_PATTERN"
        Exit Function
    End If
    ResolveBendDirectionFallback = "up"
    gLastDirWarning = "BEND_DIRECTION_ASSUMED_UP"
End Function

Private Function GetFlatPatternDirectionByIndex(bendIndex As Long) As String
    If bendIndex <= 0 Then Exit Function
    If gFlatBendDirs Is Nothing Then Exit Function
    If bendIndex > gFlatBendDirs.Count Then Exit Function
    GetFlatPatternDirectionByIndex = gFlatBendDirs(bendIndex - 1)
End Function

Private Function PrepareFlatPatternForRead(swModel As Object) As Boolean
    PrepareFlatPatternForRead = False
    Dim swFlat As Object
    Set swFlat = FindFeatureByType(swModel, "FlatPattern")
    If swFlat Is Nothing Then Exit Function
    If Not swFlat.IsSuppressed Then Exit Function
    On Error Resume Next
    swFlat.SetSuppression2 SW_UNSUPPRESS_FEATURE, SW_THIS_CONFIGURATION, Nothing
    swModel.EditRebuild3
    Err.Clear
    PrepareFlatPatternForRead = True
End Function

Private Sub RestoreFlatPatternSuppression(swModel As Object, wasSuppressed As Boolean)
    If Not wasSuppressed Then Exit Sub
    Dim swFlat As Object
    Set swFlat = FindFeatureByType(swModel, "FlatPattern")
    If swFlat Is Nothing Then Exit Sub
    On Error Resume Next
    swFlat.SetSuppression2 SW_SUPPRESS_FEATURE, SW_THIS_CONFIGURATION, Nothing
    swModel.EditRebuild3
    Err.Clear
End Sub

Private Sub CollectFlatPatternBendDirections(swModel As Object)
    Dim vFeats As Variant
    vFeats = swModel.FeatureManager.GetFeatures(True)
    If IsEmpty(vFeats) Then Exit Sub

    Dim i As Long
    Dim swFeat As Object
    For i = LBound(vFeats) To UBound(vFeats)
        Set swFeat = vFeats(i)
        If swFeat.GetTypeName2 = "FlatPattern" Then
            CollectBendDirectionsFromFeatureTree swFeat
        End If
    Next i

    ' Bend-line sketches may sit next to the flat-pattern feature in the tree
    If gFlatBendDirs.Count = 0 Then
        For i = LBound(vFeats) To UBound(vFeats)
            Set swFeat = vFeats(i)
            AddBendDirectionsFromSketchFeature swFeat
        Next i
    End If

    If gFlatBendDirs.Count = 0 Then
        Set swFeat = swModel.FirstFeature
        Do While Not swFeat Is Nothing
            CollectBendDirectionsFromFeatureTree swFeat
            Set swFeat = swFeat.GetNextFeature
        Loop
    End If
End Sub

Private Sub CollectBendDirectionsFromFeatureTree(swFeat As Object)
    AddBendDirectionsFromSketchFeature swFeat

    Dim swSub As Object
    Set swSub = swFeat.GetFirstSubFeature
    Do While Not swSub Is Nothing
        CollectBendDirectionsFromFeatureTree swSub
        Set swSub = swSub.GetNextSubFeature
    Loop
End Sub

Private Sub AddFlatBendDirection(dir As String)
    If Len(dir) = 0 Then Exit Sub
    gFlatBendDirs.Add dir, CStr(gFlatBendDirs.Count)
End Sub

Private Sub AddFlatBendLength(lengthMeters As Double)
    If lengthMeters <= 0 Then Exit Sub
    gFlatBendLengths.Add Round4(lengthMeters * 1000#), CStr(gFlatBendLengths.Count)
End Sub

Private Sub AddBendDirectionsFromSketchFeature(swFeat As Object)
    If swFeat.GetTypeName2 <> "ProfileFeature" Then Exit Sub

    Dim swSketch As Object
    Set swSketch = swFeat.GetSpecificFeature2
    If swSketch Is Nothing Then Exit Sub

    Dim vSegs As Variant
    On Error Resume Next
    vSegs = swSketch.GetSketchSegments
    If Err.Number <> 0 Or IsEmpty(vSegs) Then
        Err.Clear
        Exit Sub
    End If

    Dim i As Long
    For i = LBound(vSegs) To UBound(vSegs)
        Dim seg As Object
        Set seg = vSegs(i)
        If seg.GetType = SW_SKETCH_LINE Then
            AddFlatBendDirection TryGetSegmentBendDirection(seg)
            On Error Resume Next
            AddFlatBendLength seg.GetLength
            Err.Clear
        End If
    Next i
End Sub

Private Function TryGetSegmentBendDirection(seg As Object) As String
    On Error Resume Next
    Dim bendLineDir As Long
    bendLineDir = seg.GetBendLineDirection()
    If Err.Number = 0 Then
        TryGetSegmentBendDirection = MapBendLineDirection(bendLineDir)
        If Len(TryGetSegmentBendDirection) > 0 Then Exit Function
    End If
    Err.Clear
    bendLineDir = seg.GetBendLineDirection2()
    If Err.Number = 0 Then
        TryGetSegmentBendDirection = MapBendLineDirection(bendLineDir)
    End If
    Err.Clear
End Function

Private Function GetBendDirectionFromFeatureSketch(swFeat As Object) As String
    Dim swSub As Object
    Set swSub = swFeat.GetFirstSubFeature
    Do While Not swSub Is Nothing
        If swSub.GetTypeName2 = "ProfileFeature" Then
            Dim swSketch As Object
            Set swSketch = swSub.GetSpecificFeature2
            If Not swSketch Is Nothing Then
                Dim dir As String
                dir = GetFirstBendLineDirectionFromSketch(swSketch)
                If Len(dir) > 0 Then
                    GetBendDirectionFromFeatureSketch = dir
                    Exit Function
                End If
            End If
        End If
        Set swSub = swSub.GetNextSubFeature
    Loop
End Function

Private Function GetFirstBendLineDirectionFromSketch(swSketch As Object) As String
    On Error Resume Next
    Dim vSegs As Variant
    vSegs = swSketch.GetSketchSegments
    If Err.Number <> 0 Or IsEmpty(vSegs) Then
        Err.Clear
        Exit Function
    End If

    Dim i As Long
    For i = LBound(vSegs) To UBound(vSegs)
        Dim seg As Object
        Set seg = vSegs(i)
        If seg.GetType = SW_SKETCH_LINE Then
            GetFirstBendLineDirectionFromSketch = TryGetSegmentBendDirection(seg)
            If Len(GetFirstBendLineDirectionFromSketch) > 0 Then Exit Function
        End If
    Next i
End Function

Private Function MapBendLineDirection(bendLineDir As Long) As String
    If bendLineDir = SW_BEND_LINE_UP Then
        MapBendLineDirection = "up"
    ElseIf bendLineDir = SW_BEND_LINE_DOWN Then
        MapBendLineDirection = "down"
    Else
        MapBendLineDirection = ""
    End If
End Function

Private Function MapDirection(bendDir As Long, ByRef errMsg As String) As String
    If bendDir = SW_BEND_DIR_UP Then
        MapDirection = "up"
    ElseIf bendDir = SW_BEND_DIR_DOWN Then
        MapDirection = "down"
    Else
        errMsg = "BendDirection is not set (value=" & bendDir & ")."
        MapDirection = ""
    End If
End Function

Private Function GetFlatPatternLengthByIndex(bendIndex As Long) As Variant
    If bendIndex <= 0 Then Exit Function
    If gFlatBendLengths Is Nothing Then Exit Function
    If bendIndex > gFlatBendLengths.Count Then Exit Function
    GetFlatPatternLengthByIndex = gFlatBendLengths(bendIndex - 1)
End Function

Private Function GetBendLengthMm(swFeat As Object) As Variant
    On Error GoTo Fail
    Dim typeName As String
    typeName = swFeat.GetTypeName2

    If typeName = "OneBend" Then
        GetBendLengthMm = GetOneBendLengthMm(swFeat)
        If Not IsEmpty(GetBendLengthMm) Then Exit Function
        GetBendLengthMm = GetFlatPatternLengthByIndex(gCurrentBendIndex)
        If Not IsEmpty(GetBendLengthMm) Then Exit Function
    End If

    If typeName = "EdgeFlange" Or typeName = "MiterFlange" Or typeName = "SM3dBend" Or typeName = "SketchBend" Then
        GetBendLengthMm = GetFeatureSketchLengthMm(swFeat)
        If Not IsEmpty(GetBendLengthMm) Then Exit Function
        GetBendLengthMm = GetFlatPatternLengthByIndex(gCurrentBendIndex)
        If Not IsEmpty(GetBendLengthMm) Then Exit Function
    End If

    Dim swSketch As Object
    Set swSketch = swFeat.GetSpecificFeature2
    If swSketch Is Nothing Then GoTo Fail

    GetBendLengthMm = SumSketchSegmentsLengthMm(swSketch)
    Exit Function
Fail:
    GetBendLengthMm = Empty
End Function

Private Function GetOneBendLengthMm(swFeat As Object) As Variant
    On Error GoTo Fail
    Dim bendDef As Object
    Set bendDef = swFeat.GetDefinition
    If bendDef Is Nothing Then GoTo Fail

    Dim vSegs As Variant
    vSegs = bendDef.FlatPatternSketchSegments2
    If Err.Number <> 0 Or IsEmpty(vSegs) Then
        Err.Clear
        GoTo Fail
    End If

    Dim total As Double
    total = SumSketchSegmentsArrayLength(vSegs)
    If total > 0 Then
        GetOneBendLengthMm = Round4(total * 1000#)
    Else
        GetOneBendLengthMm = Empty
    End If
    Exit Function
Fail:
    GetOneBendLengthMm = Empty
End Function

Private Function GetFeatureSketchLengthMm(swFeat As Object) As Variant
    Dim swSub As Object
    Set swSub = swFeat.GetFirstSubFeature
    Do While Not swSub Is Nothing
        If swSub.GetTypeName2 = "ProfileFeature" Then
            Dim swSketch As Object
            Set swSketch = swSub.GetSpecificFeature2
            If Not swSketch Is Nothing Then
                GetFeatureSketchLengthMm = SumSketchSegmentsLengthMm(swSketch)
                If Not IsEmpty(GetFeatureSketchLengthMm) Then Exit Function
            End If
        End If
        Set swSub = swSub.GetNextSubFeature
    Loop
    GetFeatureSketchLengthMm = Empty
End Function

Private Function SumSketchSegmentsLengthMm(swSketch As Object) As Variant
    On Error GoTo Fail
    Dim vSegs As Variant
    vSegs = swSketch.GetSketchSegments
    If Err.Number <> 0 Or IsEmpty(vSegs) Then GoTo Fail
    Dim total As Double
    total = SumSketchSegmentsArrayLength(vSegs)
    If total > 0 Then
        SumSketchSegmentsLengthMm = Round4(total * 1000#)
    Else
        SumSketchSegmentsLengthMm = Empty
    End If
    Exit Function
Fail:
    SumSketchSegmentsLengthMm = Empty
End Function

Private Function SumSketchSegmentsArrayLength(vSegs As Variant) As Double
    On Error Resume Next
    Dim total As Double
    total = 0#
    Dim i As Long
    For i = LBound(vSegs) To UBound(vSegs)
        Dim seg As Object
        Set seg = vSegs(i)
        If seg.GetLength > 0 Then total = total + seg.GetLength
    Next i
    SumSketchSegmentsArrayLength = total
End Function

Private Function FindFeatureByType(swModel As Object, typeName As String) As Object
    Dim swFeat As Object
    Set swFeat = swModel.FirstFeature
    Do While Not swFeat Is Nothing
        If swFeat.GetTypeName2 = typeName Then
            Set FindFeatureByType = swFeat
            Exit Function
        End If
        Set swFeat = swFeat.GetNextFeature
    Loop
    Set FindFeatureByType = Nothing
End Function

Private Function GetPartNumber(partPath As String) As String
    Dim fileName As String
    fileName = Mid(partPath, InStrRev(partPath, "\") + 1)
    If InStrRev(fileName, ".") > 0 Then
        GetPartNumber = Left(fileName, InStrRev(fileName, ".") - 1)
    Else
        GetPartNumber = fileName
    End If
End Function

Private Function GetConfigFilePath() As String
    Dim folder As String
    folder = GetCadLinkMacroFolder()
    If Len(folder) = 0 Then Exit Function
    GetConfigFilePath = folder & CONFIG_FILE
End Function

Private Function ReadExportRootFromConfig() As String
    Dim configPath As String
    configPath = GetConfigFilePath()
    If Len(configPath) = 0 Then Exit Function
    If Dir(configPath) = "" Then Exit Function

    Dim content As String
    content = ReadWholeFile(configPath)
    ReadExportRootFromConfig = Trim$(GetConfigStringValue(content, "exportRoot"))
End Function

Private Function GetConfigStringValue(content As String, key As String) As String
    Dim marker As String
    marker = """" & key & """"
    Dim pos As Long
    pos = InStr(1, content, marker, vbBinaryCompare)
    If pos = 0 Then Exit Function

    pos = InStr(pos, content, ":")
    If pos = 0 Then Exit Function

    pos = InStr(pos, content, """")
    If pos = 0 Then Exit Function

    Dim posEnd As Long
    posEnd = InStr(pos + 1, content, """")
    If posEnd = 0 Then Exit Function

    GetConfigStringValue = Mid$(content, pos + 1, posEnd - pos - 1)
    GetConfigStringValue = Replace(GetConfigStringValue, "\\", "\")
End Function

Private Function ResolvePartOutputDir(partPath As String, partNumber As String, ByRef warnings As String) As String
    Dim exportRoot As String
    exportRoot = ReadExportRootFromConfig()

    If Len(exportRoot) = 0 Then
        exportRoot = Left(partPath, InStrRev(partPath, "\")) & DEFAULT_EXPORT_FOLDER
    End If

    exportRoot = Trim$(exportRoot)
    If Right(exportRoot, 1) = "\" Then exportRoot = Left(exportRoot, Len(exportRoot) - 1)

    Dim folder As String
    folder = exportRoot & "\" & SanitizeFolderName(partNumber) & "\"

    If EnsureFolderExists(folder) Then
        ResolvePartOutputDir = folder
    End If
End Function

Private Function SanitizeFolderName(name As String) As String
    Dim s As String
    s = Trim$(name)
    s = Replace(s, "\", "-")
    s = Replace(s, "/", "-")
    s = Replace(s, ":", "-")
    s = Replace(s, "*", "-")
    s = Replace(s, "?", "-")
    s = Replace(s, """", "-")
    s = Replace(s, "<", "-")
    s = Replace(s, ">", "-")
    s = Replace(s, "|", "-")
    SanitizeFolderName = s
End Function

Private Function EnsureFolderExists(folderPath As String) As Boolean
    Dim path As String
    path = folderPath
    If Right(path, 1) = "\" Then path = Left(path, Len(path) - 1)
    If Len(path) = 0 Then Exit Function

    If Dir(path, vbDirectory) <> "" Then
        EnsureFolderExists = True
        Exit Function
    End If

    Dim slashPos As Long
    slashPos = InStrRev(path, "\")
    If slashPos > 0 Then
        Dim parent As String
        parent = Left(path, slashPos)
        If Not EnsureFolderExists(parent) Then Exit Function
    End If

    On Error Resume Next
    MkDir path
    EnsureFolderExists = (Dir(path, vbDirectory) <> "")
End Function

Private Function BuildJson(partPath As String, partNumber As String, thickness As Double, materialName As String, bendsJson As String, errors As String, warnings As String) As String
    Dim fileName As String
    fileName = Mid(partPath, InStrRev(partPath, "\") + 1)

    Dim matJson As String
    If Len(materialName) > 0 Then
        matJson = """" & JsonEscape(materialName) & """"
    Else
        matJson = "null"
    End If

    BuildJson = "{" & vbCrLf & _
        "  ""schemaVersion"": ""0.1""," & vbCrLf & _
        "  ""exportedAt"": """ & JsonEscape(NowIso8601()) & """," & vbCrLf & _
        "  ""source"": {" & vbCrLf & _
        "    ""cad"": ""SolidWorks""," & vbCrLf & _
        "    ""cadVersion"": """ & JsonEscape(swApp.RevisionNumber()) & """," & vbCrLf & _
        "    ""cadLinkVersion"": """ & CADLINK_VERSION & """," & vbCrLf & _
        "    ""fileName"": """ & JsonEscape(fileName) & """," & vbCrLf & _
        "    ""filePath"": """ & JsonEscape(partPath) & """" & vbCrLf & _
        "  }," & vbCrLf & _
        "  ""partNumber"": """ & JsonEscape(partNumber) & """," & vbCrLf & _
        "  ""revision"": null," & vbCrLf & _
        "  ""thickness"": " & JsonNum(thickness) & "," & vbCrLf & _
        "  ""material"": " & matJson & "," & vbCrLf & _
        "  ""fixedFace"": null," & vbCrLf & _
        "  ""units"": ""mm""," & vbCrLf & _
        "  ""coordinateSystem"": {" & vbCrLf & _
        "    ""origin"": ""flatPattern""," & vbCrLf & _
        "    ""description"": ""Phase 1: flat pattern coordinate""" & vbCrLf & _
        "  }," & vbCrLf & _
        "  ""bends"": [" & vbCrLf & bendsJson & vbCrLf & "  ]," & vbCrLf & _
        "  ""errors"": " & JsonStringArray(errors) & "," & vbCrLf & _
        "  ""warnings"": " & JsonStringArray(warnings) & vbCrLf & _
        "}"
End Function

Private Function JsonStringArray(text As String) As String
    Dim lines() As String
    Dim cleaned As String
    cleaned = Replace(text, vbCrLf, vbLf)
    cleaned = Replace(cleaned, vbCr, vbLf)
    lines = Split(cleaned, vbLf)

    Dim result As String
    result = "["
    Dim i As Long
    Dim first As Boolean
    first = True
    For i = LBound(lines) To UBound(lines)
        If Len(Trim(lines(i))) > 0 Then
            If Not first Then result = result & ", "
            result = result & """" & JsonEscape(Trim(lines(i))) & """"
            first = False
        End If
    Next i
    result = result & "]"
    JsonStringArray = result
End Function

Private Sub WriteUtf8(path As String, content As String)
    Dim stream As Object
    Set stream = CreateObject("ADODB.Stream")
    stream.Type = 2
    stream.Charset = "utf-8"
    stream.Open
    stream.WriteText content
    stream.SaveToFile path, 2
    stream.Close
End Sub

Private Sub ShowResult(partPath As String, jsonPath As String, dxfPath As String, bendCount As Long, thickness As String, errors As String, warnings As String)
    Dim msg As String
    msg = ""
    If Len(jsonPath) > 0 Then msg = msg & "bend.json: " & jsonPath & vbCrLf
    If Len(dxfPath) > 0 Then msg = msg & "flat.dxf: " & dxfPath & vbCrLf
    If Len(jsonPath) > 0 Then msg = msg & "Folder: " & Left(jsonPath, InStrRev(jsonPath, "\")) & vbCrLf
    If Len(partPath) > 0 Then msg = msg & "Part: " & GetPartNumber(partPath) & vbCrLf
    msg = msg & "Bends: " & bendCount & vbCrLf
    If Len(thickness) > 0 Then msg = msg & "Thickness: " & thickness & " mm" & vbCrLf
    If Len(errors) > 0 Then msg = msg & vbCrLf & errors
    If Len(warnings) > 0 Then msg = msg & warnings
    swApp.SendMsgToUser msg
End Sub

Private Function JsonEscape(value As String) As String
    Dim s As String
    s = value
    s = Replace(s, "\", "\\")
    s = Replace(s, """", "\""")
    s = Replace(s, vbCrLf, "\n")
    s = Replace(s, vbCr, "\n")
    s = Replace(s, vbLf, "\n")
    s = Replace(s, vbTab, "\t")
    JsonEscape = s
End Function

Private Function JsonNum(value As Double) As String
    JsonNum = Replace(CStr(Round(value, 4)), ",", ".")
End Function

Private Function Round4(value As Double) As Double
    Round4 = Round(value, 4)
End Function

Private Function ToMm(valueMeters As Double) As Double
    ToMm = Round4(valueMeters * 1000#)
End Function

Private Function NowIso8601() As String
    NowIso8601 = Format(Now, "yyyy-mm-ddTHH:nn:ss") & "+09:00"
End Function
