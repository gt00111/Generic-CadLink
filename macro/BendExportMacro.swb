' Generic CadLink schema v0.3 launcher
' Run: Tools > Macro > Run > BendExportMacro.swb
' The v0.3 implementation is kept in the sibling BendExportMacro.exe.

Option Explicit

Private Const V03_HOST_NAME As String = "BendExportMacro.exe"

Dim swApp As Object

Sub main()
    WriteLauncherLog "SWB main started"
    If Not ConnectSwApp() Then Exit Sub
    WriteLauncherLog "Connected to SolidWorks"
    DumpActiveFeatureTree

    Dim macroFolder As String
    macroFolder = GetThisMacroFolder()
    WriteLauncherLog "Macro folder: " & macroFolder
    If Len(macroFolder) = 0 Then
        MsgBox "V03_LAUNCH_FAILED: Could not resolve the SWB folder.", _
            vbCritical, "Generic CadLink schema v0.3"
        Exit Sub
    End If

    Dim hostPath As String
    hostPath = macroFolder & V03_HOST_NAME
    WriteLauncherLog "Host path: " & hostPath
    If Dir(hostPath) = "" Then
        MsgBox "V03_HOST_MISSING: The schema v0.3 host was not found." & vbCrLf & vbCrLf & _
            hostPath & vbCrLf & vbCrLf & _
            "Run scripts\build-macro.ps1 and keep the EXE and SolidWorks.Interop DLLs beside this SWB file.", _
            vbCritical, "Generic CadLink schema v0.3"
        Exit Sub
    End If

    Dim shell As Object
    On Error GoTo LaunchFailed
    Set shell = CreateObject("WScript.Shell")
    Dim exitCode As Long
    WriteLauncherLog "Starting host"
    exitCode = shell.Run("""" & hostPath & """", 0, True)
    WriteLauncherLog "Host exit code: " & CStr(exitCode)
    If exitCode = 1 Then
        MsgBox "V03_HOST_FAILED: BendExportMacro.exe could not complete.", _
            vbCritical, "Generic CadLink schema v0.3"
    End If
    Exit Sub

LaunchFailed:
    Dim launchErrorNumber As Long
    Dim launchErrorDescription As String
    launchErrorNumber = Err.Number
    launchErrorDescription = Err.Description
    WriteLauncherLog "Launcher error " & CStr(launchErrorNumber) & ": " & launchErrorDescription
    MsgBox "V03_LAUNCH_FAILED: " & CStr(launchErrorNumber) & " - " & launchErrorDescription, _
        vbCritical, "Generic CadLink schema v0.3"
End Sub

Private Sub DumpActiveFeatureTree()
    On Error GoTo DumpFailed
    Dim model As Object
    Set model = swApp.ActiveDoc
    If model Is Nothing Then
        WriteLauncherLog "FEATURE_TREE: NO_ACTIVE_DOCUMENT"
        Exit Sub
    End If

    WriteLauncherLog "FEATURE_TREE_BEGIN: " & model.GetPathName
    Dim feature As Object
    Set feature = model.FirstFeature
    Do While Not feature Is Nothing
        DumpFeatureBranch feature, 0
        Set feature = feature.GetNextFeature
    Loop
    WriteLauncherLog "FEATURE_TREE_END"
    Exit Sub

DumpFailed:
    WriteLauncherLog "FEATURE_TREE_ERROR " & CStr(Err.Number) & ": " & Err.Description
End Sub

Private Sub DumpFeatureBranch(feature As Object, depth As Long)
    On Error GoTo BranchFailed
    WriteLauncherLog "FEATURE " & CStr(depth) & ": " & feature.Name & " | " & feature.GetTypeName2

    Dim child As Object
    Set child = feature.GetFirstSubFeature
    Do While Not child Is Nothing
        DumpFeatureBranch child, depth + 1
        Set child = child.GetNextSubFeature
    Loop
    Exit Sub

BranchFailed:
    WriteLauncherLog "FEATURE_ERROR " & CStr(depth) & ": " & CStr(Err.Number) & " - " & Err.Description
End Sub

Private Sub WriteLauncherLog(message As String)
    On Error Resume Next
    Dim shell As Object
    Set shell = CreateObject("WScript.Shell")
    Dim logPath As String
    logPath = shell.ExpandEnvironmentStrings("%TEMP%\GenericCadLink-swb.log")
    Dim fso As Object
    Set fso = CreateObject("Scripting.FileSystemObject")
    Dim stream As Object
    Set stream = fso.OpenTextFile(logPath, 8, True)
    stream.WriteLine CStr(Now) & "  " & message
    stream.Close
    On Error GoTo 0
End Sub

Private Function ConnectSwApp() As Boolean
    On Error Resume Next
    Set swApp = Nothing
    Set swApp = GetObject(, "SldWorks.Application")
    If swApp Is Nothing Then Set swApp = Application.SldWorks
    On Error GoTo 0

    If swApp Is Nothing Then
        MsgBox "Could not connect to SolidWorks.", vbCritical, "Generic CadLink schema v0.3"
        ConnectSwApp = False
    Else
        ConnectSwApp = True
    End If
End Function

Private Function GetThisMacroFolder() As String
    Dim folder As String
    folder = ""

    On Error Resume Next
    folder = CStr(swApp.GetCurrentMacroPathFolder)
    Err.Clear

    If Len(Trim(folder)) = 0 Then
        Dim macroPath As String
        macroPath = CStr(swApp.GetCurrentMacroPathName)
        If Len(macroPath) > 0 And InStrRev(macroPath, "\") > 0 Then
            folder = Left(macroPath, InStrRev(macroPath, "\"))
        End If
    End If
    On Error GoTo 0

    If Len(folder) > 0 And Right(folder, 1) <> "\" Then folder = folder & "\"
    GetThisMacroFolder = folder
End Function
